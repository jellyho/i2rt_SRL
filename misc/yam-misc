#!/usr/bin/env bash
#
# Analysis tools that are NOT the robot.
#
# i2rt is the robot repo: the arms, the controllers, the teleop rig, and the capture that feeds
# them. Rendering a recorded rollout is none of that -- it reads a finished dataset and draws a
# picture -- so it lives here rather than alongside `yam-data`, whose every subcommand touches
# hardware or a live recording.
#
#   misc/yam-misc render-gui [args]
#       GUI: pick a dataset and an episode, press Render. Reads the candidate count, the replan
#       boundaries and whether the run was adaptive off the recording itself.
#   misc/yam-misc render-samples [args]
#       The same render from the command line (what the GUI calls).
#
# Same conda env as yam-data (default: yam_ws); override with YAM_WS_ENV.
set -eo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

# Run THIS checkout's code, whichever one you launched.
#
# `uv pip install -e policy_serving` records an absolute path in the env's site-packages,
# so with several worktrees of this repo the whole conda env follows whichever one ran that
# command last — and it is per package, so `i2rt` can come from one checkout while
# `yam_policy` comes from another. Nothing announces this: you edit a file here, run
# yam-data, and the other worktree's copy executes. PYTHONPATH is searched before
# site-packages, so pinning it to $REPO makes the launcher self-consistent by construction
# and removes the need to re-run the editable install when switching worktrees.
export PYTHONPATH="$REPO:$REPO/policy_serving${PYTHONPATH:+:$PYTHONPATH}"

ENV="${YAM_WS_ENV:-yam_ws}"
if command -v conda >/dev/null 2>&1; then
    CONDA_BASE="$(conda info --base 2>/dev/null || echo "$HOME/miniconda3")"
    # shellcheck disable=SC1091
    source "$CONDA_BASE/etc/profile.d/conda.sh"
    conda activate "$ENV" 2>/dev/null || echo "yam-misc: conda env '$ENV' not found (see workstation/setup_workstation_env.sh)" >&2
elif [ -n "${LEROBOT_ENV:-}" ] && [ -f "$LEROBOT_ENV/bin/activate" ]; then
    # shellcheck disable=SC1091
    source "$LEROBOT_ENV/bin/activate"
fi

cmd="${1:-}"
shift || true
case "$cmd" in
    render-gui)     exec python -m misc.render_gui "$@" ;;
    render-samples) exec python -m misc.render_deploy_samples "$@" ;;
    *)
        echo "usage: misc/yam-misc {render-gui|render-samples} [args]" >&2
        exit 2
        ;;
esac
