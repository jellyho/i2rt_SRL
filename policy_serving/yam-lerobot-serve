#!/usr/bin/env bash
#
# Run the LeRobot policy server from its dedicated environment without having
# to activate that environment in the current shell.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
COMMAND="$HERE/.venv/bin/yam-lerobot-serve"

if [[ ! -x "$COMMAND" ]]; then
    echo "yam-lerobot-serve: policy environment not found; run:" >&2
    echo "  bash $HERE/setup_policy_env.sh" >&2
    exit 1
fi

exec "$COMMAND" "$@"
